# AI Code Review Agent Environment Variables
# Copy this file to .env and fill in your actual values (NEVER commit .env!)

# ============================================================================
# REQUIRED: GitHub (automatically provided by GitHub Actions)
# ============================================================================
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
# REPO_NAME=owner/repository
# PR_NUMBER=123

# ============================================================================
# REQUIRED: SonarCloud/SonarQube
# ============================================================================
SONAR_TOKEN=your_sonarcloud_token_here
SONAR_PROJECT_KEY=your_org_your_repo
SONAR_ORGANIZATION=your_organization

# For self-hosted SonarQube (optional, defaults to SonarCloud)
# SONAR_URL=https://your-sonarqube-instance.com/api

# ============================================================================
# REQUIRED: LLM Provider (Choose ONE or configure both for fallback)
# ============================================================================

# Option A: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Option B: Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=xxxxxxxxxxxxx
AZURE_OPENAI_DEPLOYMENT=gpt-4

# ============================================================================
# OPTIONAL: Configuration
# ============================================================================
# FULL_REVIEW=false  # Set to true for full file analysis instead of diff only
